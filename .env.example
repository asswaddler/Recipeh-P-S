# Recipeh Meal Planning App - Environment Configuration
# Copy this file to .env and update the values

# Google Apps Script Web App URL
# This is the base URL of your deployed Apps Script web app
VITE_API_BASE_URL=https://script.google.com/macros/s/AKfycbxoG5VMpffnsm6XqKdLWquC5GcvuzV0MzZkQOL3cyNvc-e6RZ14iDhW7Num4pXUCT9qqQ/exec

# API Endpoints (relative to base URL, or full URLs)
VITE_API_GET_ENDPOINT=/exec
VITE_API_SAVE_ENDPOINT=/exec

# Optional: Endpoint for saving manual grocery additions
# If not set, manual additions are stored locally only
# VITE_API_SAVE_MANUAL_ENDPOINT=/exec

# Development Mode
# Set to 'true' to use mock data without backend
VITE_USE_MOCK_DATA=false
